						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"environment\": \"{{environment}}\",\n  \"email\": \"native.user@example.com\",\n  \"password\": \"SuperSecretPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/login",
