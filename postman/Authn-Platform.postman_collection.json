{
	"info": {
		"_postman_id": "authn-platform-collection-v2",
		"name": "Authn Platform — Enterprise Engine Test Suite",
		"description": "Complete Postman test collection for Authn Engine. Includes happy paths, edge cases, 2FA, Smart Account Recovery (FR-5), OIDC/OAuth2, and Tenant Policies.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "tenantId",
			"value": "tnt_default",
			"type": "string"
		},
		{
			"key": "publishableKey",
			"value": "pk_test_sample_key",
			"type": "string"
		},
		{
			"key": "secretKey",
			"value": "sk_test_sample_secret_key",
			"type": "string"
		},
		{
			"key": "userEmail",
			"value": "user@example.com",
			"type": "string"
		},
		{
			"key": "recoveryRequestId",
			"value": "",
			"type": "string"
		},
		{
			"key": "cancellationTokens",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01 System & Health",
			"item": [
				{
					"name": "Engine Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/health",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "health"]
						}
					}
				},
				{
					"name": "OIDC Discovery Metadata",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/openid-configuration",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "openid-configuration"]
						}
					}
				},
				{
					"name": "JWKS Key Set",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/oauth/jwks",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "oauth", "jwks"]
						}
					}
				}
			]
		},
		{
			"name": "02 Core Authentication",
			"item": [
				{
					"name": "User Sign Up",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Authn-Publishable-Key", "value": "{{publishableKey}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"SecurePassword123!\",\n  \"name\": \"Alex Smith\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/signup",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "signup"]
						}
					}
				},
				{
					"name": "User Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Authn-Publishable-Key", "value": "{{publishableKey}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"SecurePassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/login",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "login"]
						}
					}
				},
				{
					"name": "Verify Email Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/client/verify-email?token=sample_verification_token",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "verify-email"],
							"query": [{ "key": "token", "value": "sample_verification_token" }]
						}
					}
				}
			]
		},
		{
			"name": "03 Passwordless Magic Links",
			"item": [
				{
					"name": "Send Magic Link",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"environment\": \"test\",\n  \"email\": \"{{userEmail}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/magic-link",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "magic-link"]
						}
					}
				},
				{
					"name": "Verify Magic Link Token",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"raw_magic_link_token\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/magic-link/verify",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "magic-link", "verify"]
						}
					}
				}
			]
		},
		{
			"name": "04 2FA & Multi-Factor Authentication",
			"item": [
				{
					"name": "Enroll TOTP",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": \"usr_123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/2fa/totp/enroll",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "2fa", "totp", "enroll"]
						}
					}
				},
				{
					"name": "Confirm TOTP Initial Code",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": \"usr_123456\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/2fa/totp/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "2fa", "totp", "confirm"]
						}
					}
				},
				{
					"name": "Verify 2FA Challenge",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"two_factor_token\": \"tft_sample_token\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/2fa/verify",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "2fa", "verify"]
						}
					}
				},
				{
					"name": "Regenerate Backup Recovery Codes",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": \"usr_123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/2fa/recovery-codes/regenerate",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "2fa", "recovery-codes", "regenerate"]
						}
					}
				}
			]
		},
		{
			"name": "05 Smart Account Recovery (FR-5)",
			"item": [
				{
					"name": "Invite Guardians (Shamir Secret Sharing)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"guardians\": [\n    { \"email\": \"guardian1@example.com\", \"name\": \"Guardian 1\" },\n    { \"email\": \"guardian2@example.com\", \"name\": \"Guardian 2\" }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/account/guardians/invite",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "account", "guardians", "invite"]
						}
					}
				},
				{
					"name": "Initiate Account Recovery",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"environment\": \"test\",\n  \"email\": \"{{userEmail}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/recovery/initiate",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "recovery", "initiate"]
						}
					}
				},
				{
					"name": "Submit Guardian Share Proof",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"recovery_request_id\": \"req_123456\",\n  \"share_payload\": \"raw_guardian_share_hex\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/recovery/proof/guardian",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "recovery", "proof", "guardian"]
						}
					}
				},
				{
					"name": "Submit Old Password Proof",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"recovery_request_id\": \"req_123456\",\n  \"password\": \"OldPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/recovery/proof/old-password",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "recovery", "proof", "old-password"]
						}
					}
				},
				{
					"name": "Claim Account (Post-Freeze Reset)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"request_id\": \"req_123456\",\n  \"claim_token\": \"raw_claim_token_hex\",\n  \"new_password\": \"NewSecurePassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/recovery/claim",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "recovery", "claim"]
						}
					}
				},
				{
					"name": "Cancel Recovery (Authenticated Session)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"recovery_request_id\": \"req_123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/recovery/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "recovery", "cancel"]
						}
					}
				},
				{
					"name": "Cancel Recovery (Public Signed Link Token)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cancellation_token\": \"raw_cancellation_token_hex\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/client/auth/recovery/cancel/token",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "client", "auth", "recovery", "cancel", "token"]
						}
					}
				}
			]
		},
		{
			"name": "06 Admin Policies & Keys",
			"item": [
				{
					"name": "Get Tenant Recovery Policy",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/tenant/recovery-policy?tenant_id={{tenantId}}",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "tenant", "recovery-policy"],
							"query": [{ "key": "tenant_id", "value": "{{tenantId}}" }]
						}
					}
				},
				{
					"name": "Update Tenant Recovery Policy",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"guardians_enabled\": true,\n  \"phone_otp_enabled\": true,\n  \"email_otp_enabled\": true,\n  \"old_password_enabled\": true,\n  \"security_questions_enabled\": true,\n  \"freeze_window_hours\": 48,\n  \"claim_token_ttl_minutes\": 15,\n  \"lockout_schedule\": [\"24h\", \"3d\", \"7d\", \"14d\", \"4w\", \"8w\", \"12w\", \"permanent\"],\n  \"lockout_reset_days\": 30,\n  \"trusted_device_window_days\": 90,\n  \"ipv4_subnet_bits\": 24,\n  \"ipv6_subnet_bits\": 48,\n  \"max_proof_attempts_per_window\": 5,\n  \"min_guardians\": 1,\n  \"max_guardians\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/tenant/recovery-policy?tenant_id={{tenantId}}",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "tenant", "recovery-policy"],
							"query": [{ "key": "tenant_id", "value": "{{tenantId}}" }]
						}
					}
				},
				{
					"name": "Create API Key",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{secretKey}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Stripe Webhook Key\",\n  \"type\": \"publishable\",\n  \"environment\": \"test\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/admin/keys/",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "admin", "keys", ""]
						}
					}
				},
				{
					"name": "List API Keys",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{secretKey}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/v1/admin/keys/",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "admin", "keys", ""]
						}
					}
				}
			]
		}
	]
}
