###############################################################################
# Authn Platform — Environment Configuration
#
# Copy to .env and adjust. Every value below has a working default for local
# development, so a fresh clone runs with no edits at all.
#
# How this file is read:
#   - Real environment variables always win over this file, so container and CI
#     settings are never overridden by a file left in an image.
#   - The server validates everything at startup. A malformed value stops the
#     process with a message naming the variable — it never silently falls back.
#   - Durations use Go syntax: 30s, 15m, 24h, 720h.
#
# Variables marked [PRODUCTION] have no default when APP_ENV=production and
# must be set explicitly.
###############################################################################


#==============================================================================
# 1. ENVIRONMENT
#==============================================================================

# Deployment tier: development | test | production
# Production enforces HTTPS URLs, explicit secrets, and disables auto-migration.
APP_ENV=development


#==============================================================================
# 2. SERVER
#==============================================================================

# Interface to bind. 0.0.0.0 accepts external connections; 127.0.0.1 is local only.
HOST=0.0.0.0
PORT=8080

# Connection timeouts. These bound how long one client can occupy a worker;
# without them a stalled connection is held open indefinitely.
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Grace period for in-flight requests to finish after a shutdown signal.
SERVER_SHUTDOWN_TIMEOUT=30s

# Largest accepted request body, in bytes (default 4 MiB).
SERVER_BODY_LIMIT_BYTES=4194304

# Read the client IP from X-Forwarded-For instead of the socket peer address.
# Enable ONLY behind a proxy you control. That header is trivially forged, so
# trusting it with no proxy in front lets a caller present a fresh IP on every
# request and walk straight past per-IP rate limits.
SERVER_TRUST_PROXY_HEADERS=false


#==============================================================================
# 3. PUBLIC IDENTITY
#==============================================================================

# Product name shown to users: in outbound mail, and as the issuer label an
# authenticator app displays beside a TOTP entry.
#
# Changing it after users have enrolled TOTP is cosmetic but confusing — existing
# authenticator entries keep the old label, because the issuer is baked into the
# enrollment URI and cannot be updated remotely.
AUTHN_APP_NAME="Authn Platform"

# Build identifier reported by /v1/health and the startup banner, and shown in
# the account app's footer. The web apps read this same variable at build time
# rather than a NEXT_PUBLIC_ twin, so there is one version to bump.
AUTHN_APP_VERSION=0.1.0

# The engine's own public URL — the address a browser actually reaches.
# Behind a TLS-terminating proxy this is the https:// address, not the internal one.
#
# Used to build social login callbacks and SAML metadata, and it decides whether
# session cookies are marked Secure. Emailed links use WEB_ACCOUNT_URL instead,
# because a link has to open a page rather than call the API. [PRODUCTION: must be https]
APP_BASE_URL=http://localhost:8080

# OpenID Connect issuer identifier, published in the `iss` claim and at the
# discovery endpoint. Changing it invalidates tokens relying parties already trust.
ISSUER_URL=http://localhost:8080


#==============================================================================
# 4. CROSS-ORIGIN REQUESTS (CORS)
#==============================================================================

# Browser origins allowed to call this API. Comma-separated, exact match,
# scheme + host + port with no trailing path.
#
# A wildcard "*" is REFUSED while CORS_ALLOW_CREDENTIALS=true, and refused
# outright in production: reflecting any origin with credentials enabled lets
# any website a signed-in user visits call this API with their cookies attached
# and read the replies.
#
# One origin per web app, and they must track the WEB_*_PORT values in section 16
# — a dev server on a port absent from this list has every request blocked by the
# browser before the engine sees it.
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001

CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Every header a handler reads. A browser blocks any request carrying a header
# absent from this list, so dropping one here disables the feature that reads it.
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Authn-Publishable-Key,X-Authn-Secret-Key,X-Authn-Client-Type

# Required for cookie-based sessions in a browser.
CORS_ALLOW_CREDENTIALS=true

# How long a browser may cache the preflight result.
CORS_MAX_AGE=12h


#==============================================================================
# 5. DATABASE
#==============================================================================

# The URL scheme selects the engine and driver — there is no separate
# "database type" setting to fall out of sync. Supported:
#
#   postgres://user:password@host:5432/authn?sslmode=require
#   mysql://user:password@host:3306/authn
#   sqlite://file:authn.db?_fk=1
#
# [PRODUCTION: required]
DATABASE_URL="sqlite://file:authn.db?_fk=1&cache=shared"

# Connection pool. Keep MAX_OPEN_CONNS × instance count below the database
# server's own connection limit.
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# Retire connections after this age so instances notice failovers and DNS
# changes instead of holding a dead socket.
DATABASE_CONN_MAX_LIFETIME=30m

# Create or update schema tables at startup. Convenient locally; in production
# run migrations as a reviewed deployment step instead, so schema changes are
# not applied by whichever instance happens to boot first.
# [PRODUCTION: must be false]
DATABASE_AUTO_MIGRATE=true


#==============================================================================
# 6. REDIS
#==============================================================================

# Backs rate limiting and caching. [PRODUCTION: required]
REDIS_URL=redis://localhost:6379

# Make an unreachable Redis a startup failure rather than a degraded start.
# Rate limiting needs shared state, so running several instances without it
# weakens brute-force defence.
REDIS_REQUIRED=false


#==============================================================================
# 7. CRYPTOGRAPHIC SECRETS
#==============================================================================
# Generate each with:  openssl rand -base64 32
# Use DIFFERENT values — startup rejects them being equal in production.
# Never commit real secrets. [PRODUCTION: both required, minimum 32 characters]

# AES-256-GCM key protecting secrets at rest (stored TOTP seeds, provider
# credentials). Rotating it makes existing ciphertext unreadable.
AUTHN_ENCRYPTION_KEY=

# Mixed into API key hashes and stored separately from them, so a
# database-only leak still cannot be brute-forced offline.
AUTHN_API_KEY_PEPPER=

# Identifies the active signing key in the published JWKS.
JWT_KEY_ID=key_v1

# RSA private key used to sign OpenID Connect ID tokens.
JWT_SIGNING_KEY_PATH=.keys/rsa_private.pem


#==============================================================================
# 8. TOKEN & SESSION LIFETIMES
#==============================================================================

# Short access tokens limit the damage of a leak; the refresh token carries
# the long-lived session. ACCESS_TOKEN_TTL must be shorter than REFRESH_TOKEN_TTL.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Window in which a just-rotated refresh token still works, so concurrent
# in-flight requests during rotation are not all logged out.
SESSION_GRACE_PERIOD=10s

EMAIL_VERIFICATION_TTL=24h

# Kept short: the link alone grants a session.
MAGIC_LINK_TTL=15m

# Lifetime of the token issued between password success and second-factor entry.
MFA_CHALLENGE_TTL=5m

# CSRF state for a social login round trip.
SOCIAL_AUTH_STATE_TTL=10m

# Authorization codes are single-use and redeemed immediately. RFC 6749
# recommends 10 minutes as the maximum; startup rejects anything longer.
OAUTH_CODE_TTL=10m

ID_TOKEN_TTL=1h
RECOVERY_TOKEN_TTL=1h

# Default organization invitation lifetime when the caller does not specify one.
INVITATION_TTL=168h


#==============================================================================
# 8b. DATA RETENTION
#==============================================================================

# How often the background sweeper deletes rows that have aged out. It also
# bounds how long one sweep may run, so a large backlog is cleared over several
# passes rather than in one long transaction.
RETENTION_SWEEP_INTERVAL=15m

# How long a session row that a refresh replaced is kept. Until it is deleted, a
# replay of its old refresh token is recognised as token theft and revokes the
# user's sessions; afterwards the same replay is only an unknown token. This is
# therefore the width of the theft-detection window, and these rows are the
# highest-volume class in the table — one per refresh.
SUPERSEDED_SESSION_RETENTION=72h

# How long an expired or revoked session row is kept. These are what the user
# reads back as sign-in history, so keep it at least REFRESH_TOKEN_TTL to avoid
# deleting sessions that could still have been refreshed.
TERMINAL_SESSION_RETENTION=720h

# How long a message captured by the test-environment sandbox is kept. These
# bodies hold verification links and one-time codes in plain text, because a test
# harness has to read them, so a long window is an accumulating store of working
# credentials. A test reads its message within seconds of triggering it. Must be
# positive; zero fails the boot rather than disabling the sweep.
SANDBOX_MESSAGE_RETENTION=24h

# How long a test-environment account is kept past its last sign-in — or past its
# registration, when it never signed in — before the sweeper deletes it and
# everything hanging off it. This is what keeps TEST_MAX_USERS from becoming a
# wall: suites create accounts by the thousand and abandon them, and a tenant that
# reached its ceiling through months of accumulated runs would start failing runs
# that have nothing wrong with them. Live accounts are never swept at any setting;
# an idle customer is still a customer.
TEST_USER_RETENTION=720h

# Rows deleted per statement. Larger clears a backlog in fewer passes; smaller
# holds locks for less time on each one.
RETENTION_BATCH_SIZE=1000


#==============================================================================
# 9. RATE LIMITING
#==============================================================================

RATELIMIT_ENABLED=true

# Allowance per window for one account.
RATELIMIT_MAX_ATTEMPTS=5
RATELIMIT_WINDOW=15m

# The per-IP allowance is this multiple of the per-account one, so a shared
# office or mobile-carrier address is not locked out by one user's typos.
RATELIMIT_IP_BUDGET_MULTIPLIER=10

# Escalating lockout for repeat offenders, longest last.
RATELIMIT_BACKOFF_SCHEDULE=15m,1h,6h,24h

# Days of clean record before an offender's escalation level resets.
RATELIMIT_VIOLATION_RESET_DAYS=7

# Reject requests when Redis is unreachable rather than letting them through
# unchecked. Defaults to true in production.
RATELIMIT_FAIL_CLOSED=false

# Verification-email resends cost money and can be aimed at a third party's
# inbox, so they carry a tighter budget of their own.
RESEND_RATELIMIT_ENABLED=true
RESEND_RATELIMIT_MAX_ATTEMPTS=3
RESEND_RATELIMIT_WINDOW=1h


#==============================================================================
# 10. EMAIL DELIVERY
#==============================================================================

# Driver: smtp | resend | sendgrid | postmark | aws_ses | noop
# "noop" logs messages instead of sending — the safe local default.
# Startup fails if the selected driver's credentials are missing, so a
# verification email can never silently fail to send.
EMAIL_DRIVER=noop

EMAIL_FROM_ADDRESS=noreply@authn.local
EMAIL_FROM_NAME=Authn

# SMTP (works with Mailpit or MailHog locally on port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Hosted providers — set only the one matching EMAIL_DRIVER.
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1


#==============================================================================
# 11. SMS DELIVERY
#==============================================================================

# Driver: twilio | messagebird | aws_sns | noop
SMS_DRIVER=noop

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MESSAGEBIRD_ACCESS_KEY=
MESSAGEBIRD_ORIGINATOR=Authn


#==============================================================================
# 12. WEBAUTHN / PASSKEYS
#==============================================================================

# The domain passkeys are bound to — bare hostname, no scheme, no port.
#
# WARNING: changing this invalidates every enrolled passkey. The browser
# refuses to release a credential registered under a different domain.
# [PRODUCTION: must not be localhost]
WEBAUTHN_RP_ID=localhost

# Full origins allowed to start a passkey ceremony. Each must resolve to
# WEBAUTHN_RP_ID or a subdomain of it; startup rejects a mismatch, which would
# otherwise surface only as passkey enrolment failing in the browser.
WEBAUTHN_RP_ORIGINS=http://localhost:8080,http://localhost:3000

WEBAUTHN_RP_DISPLAY_NAME="Authn Platform"


#==============================================================================
# 13. SAML
#==============================================================================

# Path where identity providers post SAML assertions. Combined with
# APP_BASE_URL this forms the absolute ACS URL published in SP metadata.
SAML_ACS_PATH=/v1/saml/acs

# Namespace the service-provider entity ID is built from; the organization ID is
# appended. It is an opaque identifier an IdP records for us and does not have to
# resolve. Published in SP metadata AND checked against an assertion's
# AudienceRestriction, so both derive from this one value. Changing it after a
# provider is configured requires re-registering there.
SAML_SP_ENTITY_ID_PREFIX=https://authn.com/saml/sp/



#==============================================================================
# 14. ORGANIZATIONS
#==============================================================================

# Cap on the JSON metadata blob stored per organization (default 10 KiB).
ORG_METADATA_MAX_BYTES=10240


#==============================================================================
# 14b. TEST-ENVIRONMENT CEILINGS
#==============================================================================

# How much one tenant may hold in its test environment, and how long a credential
# it issues there may live. A test environment is free and unmetered, which makes
# it the cheapest place to run something that is not a test; these ceilings are
# what keep it a development surface. The defaults are far above any test suite and
# far below a product, so they are invisible to the intended use.
#
# They bind a request only when it presents a test credential. A live key is
# never bounded by them, so a deployment cannot cap its own customers here.
# Every setting here must be positive; zero fails the boot rather than quietly
# lifting a ceiling somebody meant to set.
#
# A create refused for want of room answers 403 with code test_quota_exceeded —
# not 429, because waiting does not help: room is made by deleting rows or by
# moving to live.
TEST_MAX_USERS=500

# Workspaces one tenant may hold in test. Organizations carry an environment of
# their own, so a tenant's live workspaces do not consume the room its test ones
# have — a customer running a full production estate can still rehearse.
TEST_MAX_ORGANIZATIONS=25

# Counts the publishable/secret pair provisioning installs with each application,
# so the effective room for keys issued through the API is this minus two.
TEST_MAX_API_KEYS=20

# Ceiling on a test access token's lifetime, replacing ACCESS_TOKEN_TTL and any
# longer figure a tenant configured. A harness needing one for longer than a few
# minutes is running something other than a test, and until it expires the token is
# a bearer credential for whoever read it out of a log or a CI record.
TEST_ACCESS_TOKEN_TTL=15m

# Ceiling on a test session's lifetime, and so on how long its refresh token keeps
# minting access tokens. A test signs in when it runs, so nothing there needs a
# session that survives to the next run. Must stay longer than
# TEST_ACCESS_TOKEN_TTL: a session exists to outlive the tokens it mints.
TEST_SESSION_TTL=24h


#==============================================================================
# 15. FEATURE FLAGS
#==============================================================================

FEATURE_PUSH_2FA_ENABLED=true
FEATURE_MAGIC_LINK_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_RBAC_ENABLED=true
FEATURE_IMPERSONATION_ENABLED=true


#==============================================================================
# 15b. BACKGROUND WORKERS
#==============================================================================

# Goroutines delivering webhooks concurrently. Bounds how much outbound traffic
# one instance aims at a single subscriber.
WEBHOOK_WORKER_COUNT=5

# How often Redis is probed to decide whether the engine is in degraded mode.
# Shorter notices an outage sooner, at the cost of more probes.
DEGRADED_MODE_CHECK_INTERVAL=1s


#==============================================================================
# 16. WEB APPS & SDK  (read by the Next.js apps and @authn/js, not the engine)
#==============================================================================

# This file is the only source of truth for the web apps as well as the engine.
# Next.js loads .env from its own directory, so each app reaches this one
# explicitly — `dotenv -e ../../.env` for values needed before Next boots (the
# port), and a load inside next.config.ts for the NEXT_PUBLIC_ values, which are
# inlined into the bundle at build time rather than read at runtime.

# Ports the Next.js dev servers bind. Independent of the engine's PORT: all of
# them run at once in development, so they must not collide.
WEB_CONSOLE_PORT=4000
WEB_ACCOUNT_PORT=4001

# Where the engine points every emailed link: verification, magic link, email
# change, recovery email. The link lands on a page, which then makes the API call
# with the publishable key it already holds — a link aimed at the engine itself
# cannot set that header, and for a magic link the reply is a usable credential.
#
# Must track WEB_ACCOUNT_PORT above, and the engine's compiled fallback in
# internal/config (http://localhost:4001) assumes that pair. An application row's
# frontend_base_url overrides this per application; this is the default when it is
# unset.
# [PRODUCTION: must be https]
WEB_ACCOUNT_URL=http://localhost:4001

NEXT_PUBLIC_AUTHN_API_URL=http://localhost:8080

# Publishable keys are safe to expose in browser code. Secret keys (sk_...)
# are not, and must never appear in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_AUTHN_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret keys (sk_...) grant full administrative access to your tenant.
# Use ONLY in server-side code (Node.js, Next.js API routes, server actions).
# Never expose in client-side code or NEXT_PUBLIC_ variables.
AUTHN_SECRET_KEY=sk_test_your_secret_key_here


#==============================================================================
# 17. TENANT PROVISIONING  (hosted control plane; leave empty when self-hosting)
#==============================================================================

# The tenant whose end users are the operators of a hosted deployment — the
# control plane running as a tenant of itself.
#
# Empty disables the hosted front door entirely, which is the self-hosted
# default: the platform routes answer 404 rather than 403, so a deployment with
# no control plane does not advertise one. Both variables must be set together.
#
# The slug is reserved so no customer can provision over the control plane.
# Provisioning resolves by slug, so without the reservation a caller naming it
# would be handed the existing control-plane tenant instead of a new one.
PLATFORM_TENANT_ID=
PLATFORM_TENANT_SLUG=
