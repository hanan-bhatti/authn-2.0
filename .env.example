# ==========================================
# Authn Platform — Environment Variables
# ==========================================

# Centralized Platform Identity & Versioning
# All packages read these to stay consistent.
AUTHN_APP_NAME=Authn Platform
AUTHN_APP_VERSION=0.1.0
AUTHN_APP_DESCRIPTION=Enterprise Open-Source Authentication & Identity Platform
AUTHN_APP_HOMEPAGE=https://github.com/hanan-bhatti/authn-2.0

# Server Configuration
PORT=8080
ENV=development # development | test | production

# Database Connection (PostgreSQL 16 / MySQL / SQLite)
# SQLite dev mode: file:authn.db?_fk=1
DATABASE_URL=postgres://authn:secret@localhost:5432/authn?sslmode=disable

# Redis Cache / Dragonfly Store
AUTHN_REDIS_URL=redis://localhost:6379

# Cryptography & Key Management Secrets
# MUST be 32-byte cryptographically random hex strings in production!
AUTHN_ENCRYPTION_KEY=32_byte_random_kms_encryption_key!
AUTHN_API_KEY_PEPPER=32_byte_random_api_key_pepper_key!
JWT_SIGNING_KEY_PATH=/etc/authn/keys/rsa_private.pem

# Multi-Dimensional Rate Limiting Configuration (IP & Global)
AUTHN_RATELIMIT_ENABLED=true
AUTHN_RATELIMIT_MAX_ATTEMPTS=5
AUTHN_RATELIMIT_WINDOW_SECONDS=900
AUTHN_RATELIMIT_BACKOFF_SCHEDULE=15m,1h,6h,24h
AUTHN_RATELIMIT_VIOLATION_RESET_DAYS=7

# Per-Email Resend Verification Rate Limiting Configuration
AUTHN_RESEND_RATELIMIT_ENABLED=true
AUTHN_RESEND_RATELIMIT_MAX_ATTEMPTS=3
AUTHN_RESEND_RATELIMIT_WINDOW_SECONDS=3600

# Email & Communication Provider Settings (Drivers: smtp | resend | sendgrid | postmark | aws_ses | noop)
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=re_123456789
SENDGRID_API_KEY=SG.123456789
POSTMARK_SERVER_TOKEN=pm_123456789
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
EMAIL_FROM_ADDRESS=noreply@authn.com
APP_BASE_URL=http://localhost:8080

# SMS / WhatsApp Provider Settings (Drivers: twilio | messagebird | aws_sns | noop)
SMS_DRIVER=noop
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
MESSAGEBIRD_ACCESS_KEY=your_access_key
MESSAGEBIRD_ORIGINATOR=Authn

# Web Console Application URL
NEXT_PUBLIC_AUTHN_API_URL=http://localhost:8080

# SDK Client Configuration (used by @authn/js and @authn/react)
NEXT_PUBLIC_AUTHN_PUBLISHABLE_KEY=pk_test_your_publishable_key_here_32chars
