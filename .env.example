###############################################################################
# Authn Platform — Environment Configuration
#
# Copy to .env and adjust. Every value below has a working default for local
# development, so a fresh clone runs with no edits at all.
#
# How this file is read:
#   - Real environment variables always win over this file, so container and CI
#     settings are never overridden by a file left in an image.
#   - The server validates everything at startup. A malformed value stops the
#     process with a message naming the variable — it never silently falls back.
#   - Durations use Go syntax: 30s, 15m, 24h, 720h.
#
# Variables marked [PRODUCTION] have no default when APP_ENV=production and
# must be set explicitly.
###############################################################################


#==============================================================================
# 1. ENVIRONMENT
#==============================================================================

# Deployment tier: development | test | production
# Production enforces HTTPS URLs, explicit secrets, and disables auto-migration.
APP_ENV=development


#==============================================================================
# 2. SERVER
#==============================================================================

# Interface to bind. 0.0.0.0 accepts external connections; 127.0.0.1 is local only.
HOST=0.0.0.0
PORT=8080

# Connection timeouts. These bound how long one client can occupy a worker;
# without them a stalled connection is held open indefinitely.
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Grace period for in-flight requests to finish after a shutdown signal.
SERVER_SHUTDOWN_TIMEOUT=30s

# Largest accepted request body, in bytes (default 4 MiB).
SERVER_BODY_LIMIT_BYTES=4194304

# Read the client IP from X-Forwarded-For instead of the socket peer address.
# Enable ONLY behind a proxy you control. That header is trivially forged, so
# trusting it with no proxy in front lets a caller present a fresh IP on every
# request and walk straight past per-IP rate limits.
SERVER_TRUST_PROXY_HEADERS=false


#==============================================================================
# 3. PUBLIC IDENTITY
#==============================================================================

# Product name shown to users: in outbound mail, and as the issuer label an
# authenticator app displays beside a TOTP entry.
#
# Changing it after users have enrolled TOTP is cosmetic but confusing — existing
# authenticator entries keep the old label, because the issuer is baked into the
# enrollment URI and cannot be updated remotely.
AUTHN_APP_NAME="Authn Platform"

# Build identifier reported by /v1/health and the startup banner.
AUTHN_APP_VERSION=1.0.0

# The engine's own public URL — the address a browser actually reaches.
# Behind a TLS-terminating proxy this is the https:// address, not the internal one.
#
# Used to build email links, social login callbacks and SAML metadata, and it
# decides whether session cookies are marked Secure. [PRODUCTION: must be https]
APP_BASE_URL=http://localhost:8080

# OpenID Connect issuer identifier, published in the `iss` claim and at the
# discovery endpoint. Changing it invalidates tokens relying parties already trust.
ISSUER_URL=http://localhost:8080


#==============================================================================
# 4. CROSS-ORIGIN REQUESTS (CORS)
#==============================================================================

# Browser origins allowed to call this API. Comma-separated, exact match,
# scheme + host + port with no trailing path.
#
# A wildcard "*" is REFUSED while CORS_ALLOW_CREDENTIALS=true, and refused
# outright in production: reflecting any origin with credentials enabled lets
# any website a signed-in user visits call this API with their cookies attached
# and read the replies.
CORS_ALLOWED_ORIGINS=http://localhost:3000

CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Authn-Publishable-Key,X-Authn-Secret-Key,X-Authn-Api-Key,X-Authn-Tenant-Id,X-Authn-Environment

# Required for cookie-based sessions in a browser.
CORS_ALLOW_CREDENTIALS=true

# How long a browser may cache the preflight result.
CORS_MAX_AGE=12h


#==============================================================================
# 5. DATABASE
#==============================================================================

# The URL scheme selects the engine and driver — there is no separate
# "database type" setting to fall out of sync. Supported:
#
#   postgres://user:password@host:5432/authn?sslmode=require
#   mysql://user:password@host:3306/authn
#   sqlite://file:authn.db?_fk=1
#
# [PRODUCTION: required]
DATABASE_URL="sqlite://file:authn.db?_fk=1&cache=shared"

# Connection pool. Keep MAX_OPEN_CONNS × instance count below the database
# server's own connection limit.
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# Retire connections after this age so instances notice failovers and DNS
# changes instead of holding a dead socket.
DATABASE_CONN_MAX_LIFETIME=30m

# Create or update schema tables at startup. Convenient locally; in production
# run migrations as a reviewed deployment step instead, so schema changes are
# not applied by whichever instance happens to boot first.
# [PRODUCTION: must be false]
DATABASE_AUTO_MIGRATE=true


#==============================================================================
# 6. REDIS
#==============================================================================

# Backs rate limiting and caching. [PRODUCTION: required]
REDIS_URL=redis://localhost:6379

# Make an unreachable Redis a startup failure rather than a degraded start.
# Rate limiting needs shared state, so running several instances without it
# weakens brute-force defence.
REDIS_REQUIRED=false


#==============================================================================
# 7. CRYPTOGRAPHIC SECRETS
#==============================================================================
# Generate each with:  openssl rand -base64 32
# Use DIFFERENT values — startup rejects them being equal in production.
# Never commit real secrets. [PRODUCTION: both required, minimum 32 characters]

# AES-256-GCM key protecting secrets at rest (stored TOTP seeds, provider
# credentials). Rotating it makes existing ciphertext unreadable.
AUTHN_ENCRYPTION_KEY=

# Mixed into API key hashes and stored separately from them, so a
# database-only leak still cannot be brute-forced offline.
AUTHN_API_KEY_PEPPER=

# Identifies the active signing key in the published JWKS.
JWT_KEY_ID=key_v1

# RSA private key used to sign OpenID Connect ID tokens.
JWT_SIGNING_KEY_PATH=.keys/rsa_private.pem


#==============================================================================
# 8. TOKEN & SESSION LIFETIMES
#==============================================================================

# Short access tokens limit the damage of a leak; the refresh token carries
# the long-lived session. ACCESS_TOKEN_TTL must be shorter than REFRESH_TOKEN_TTL.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Window in which a just-rotated refresh token still works, so concurrent
# in-flight requests during rotation are not all logged out.
SESSION_GRACE_PERIOD=10s

EMAIL_VERIFICATION_TTL=24h

# Kept short: the link alone grants a session.
MAGIC_LINK_TTL=15m

# Lifetime of the token issued between password success and second-factor entry.
MFA_CHALLENGE_TTL=5m

# CSRF state for a social login round trip.
SOCIAL_AUTH_STATE_TTL=10m

# Authorization codes are single-use and redeemed immediately. RFC 6749
# recommends 10 minutes as the maximum; startup rejects anything longer.
OAUTH_CODE_TTL=10m

ID_TOKEN_TTL=1h
RECOVERY_TOKEN_TTL=1h

# Default organization invitation lifetime when the caller does not specify one.
INVITATION_TTL=168h


#==============================================================================
# 9. RATE LIMITING
#==============================================================================

RATELIMIT_ENABLED=true

# Allowance per window for one account.
RATELIMIT_MAX_ATTEMPTS=5
RATELIMIT_WINDOW=15m

# The per-IP allowance is this multiple of the per-account one, so a shared
# office or mobile-carrier address is not locked out by one user's typos.
RATELIMIT_IP_BUDGET_MULTIPLIER=10

# Escalating lockout for repeat offenders, longest last.
RATELIMIT_BACKOFF_SCHEDULE=15m,1h,6h,24h

# Days of clean record before an offender's escalation level resets.
RATELIMIT_VIOLATION_RESET_DAYS=7

# Reject requests when Redis is unreachable rather than letting them through
# unchecked. Defaults to true in production.
RATELIMIT_FAIL_CLOSED=false

# Verification-email resends cost money and can be aimed at a third party's
# inbox, so they carry a tighter budget of their own.
RESEND_RATELIMIT_ENABLED=true
RESEND_RATELIMIT_MAX_ATTEMPTS=3
RESEND_RATELIMIT_WINDOW=1h


#==============================================================================
# 10. EMAIL DELIVERY
#==============================================================================

# Driver: smtp | resend | sendgrid | postmark | aws_ses | noop
# "noop" logs messages instead of sending — the safe local default.
# Startup fails if the selected driver's credentials are missing, so a
# verification email can never silently fail to send.
EMAIL_DRIVER=noop

EMAIL_FROM_ADDRESS=noreply@authn.local
EMAIL_FROM_NAME=Authn

# SMTP (works with Mailpit or MailHog locally on port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Hosted providers — set only the one matching EMAIL_DRIVER.
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1


#==============================================================================
# 11. SMS DELIVERY
#==============================================================================

# Driver: twilio | messagebird | aws_sns | noop
SMS_DRIVER=noop

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MESSAGEBIRD_ACCESS_KEY=
MESSAGEBIRD_ORIGINATOR=Authn


#==============================================================================
# 12. WEBAUTHN / PASSKEYS
#==============================================================================

# The domain passkeys are bound to — bare hostname, no scheme, no port.
#
# WARNING: changing this invalidates every enrolled passkey. The browser
# refuses to release a credential registered under a different domain.
# [PRODUCTION: must not be localhost]
WEBAUTHN_RP_ID=localhost

# Full origins allowed to start a passkey ceremony. Each must resolve to
# WEBAUTHN_RP_ID or a subdomain of it; startup rejects a mismatch, which would
# otherwise surface only as passkey enrolment failing in the browser.
WEBAUTHN_RP_ORIGINS=http://localhost:8080,http://localhost:3000

WEBAUTHN_RP_DISPLAY_NAME="Authn Platform"


#==============================================================================
# 13. SAML
#==============================================================================

# Path where identity providers post SAML assertions. Combined with
# APP_BASE_URL this forms the absolute ACS URL published in SP metadata.
SAML_ACS_PATH=/v1/saml/acs


#==============================================================================
# 14. ORGANIZATIONS
#==============================================================================

# Cap on the JSON metadata blob stored per organization (default 10 KiB).
ORG_METADATA_MAX_BYTES=10240


#==============================================================================
# 15. FEATURE FLAGS
#==============================================================================

FEATURE_PUSH_2FA_ENABLED=true
FEATURE_MAGIC_LINK_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_RBAC_ENABLED=true
FEATURE_IMPERSONATION_ENABLED=true


#==============================================================================
# 16. WEB CONSOLE & SDK  (read by the Next.js app and @authn/js, not the engine)
#==============================================================================

NEXT_PUBLIC_AUTHN_API_URL=http://localhost:8080

# Publishable keys are safe to expose in browser code. Secret keys (sk_...)
# are not, and must never appear in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_AUTHN_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
