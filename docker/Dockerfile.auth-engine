# Authn Platform — Enterprise Identity Engine
# Image for the Go auth engine.
#
# Two stages so the shipped image carries the binary and its certificates and
# nothing else: no compiler, no module cache, no source. That is a smaller
# image, but the point is that a process which never needs a shell should not
# have one available if it is ever compromised.

# --- build -------------------------------------------------------------------
FROM golang:1.26-alpine AS build

# git is needed for module resolution of any VCS-backed dependency.
RUN apk add --no-cache git

WORKDIR /src

# Manifests first. This layer is rebuilt only when dependencies change, so
# ordinary source edits reuse the downloaded module cache.
COPY go.work go.work.sum ./
COPY apps/auth-engine/go.mod apps/auth-engine/go.sum ./apps/auth-engine/
RUN go mod download all

COPY apps/auth-engine ./apps/auth-engine

# CGO_ENABLED=0 produces a static binary that runs on a bare image with no libc.
# The sqlite driver needs cgo, so this build supports Postgres only — which is
# what a deployment using this image should be running anyway.
#
# -trimpath keeps local filesystem paths out of the binary; -w -s drop DWARF and
# the symbol table, neither of which is useful in a shipped artifact.
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-w -s -X main.version=${VERSION}" \
      -o /out/auth-engine \
      ./apps/auth-engine/cmd/server

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" \
      -o /out/bootstrap ./apps/auth-engine/cmd/bootstrap && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" \
      -o /out/migrate ./apps/auth-engine/cmd/migrate

# --- runtime -----------------------------------------------------------------
FROM alpine:3.21

# ca-certificates lets the engine make outbound TLS calls to identity providers
# and email or SMS APIs. wget backs the container healthcheck.
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10001 -h /app authn

WORKDIR /app

COPY --from=build /out/auth-engine /usr/local/bin/auth-engine
COPY --from=build /out/bootstrap   /usr/local/bin/bootstrap
COPY --from=build /out/migrate     /usr/local/bin/migrate

# An unprivileged user by default: nothing here needs root, and a container
# breakout costs less when the process inside was never root to begin with.
USER authn

EXPOSE 8080

# /v1/ready checks the database and Redis, so it reports whether the process can
# actually serve traffic rather than merely that it is running.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/v1/ready || exit 1

ENTRYPOINT ["/usr/local/bin/auth-engine"]
