# Keep the build context small and free of anything that must not reach an image.
#
# Secrets first: an .env copied into a layer stays in the image history even if a
# later layer deletes it.
.env
.env.*
!.env.example
*.pem
*.key

# Build outputs and dependencies, all restored inside the image.
node_modules
dist
build
bin
target
.next
*.db
*.db-journal

# Local tooling and history that has no bearing on the binary.
.git
.github
.claude
.vscode
.idea
coverage
*.log
*.test
*.out

# Platform builds that are not part of the Go engine image.
apps/mobile-android
apps/mobile-ios
