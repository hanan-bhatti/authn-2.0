    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@authn/config-eslint": "workspace:*",
    "@authn/config-typescript": "workspace:*",
    "prettier": "^3.5.0",
    "turbo": "^2.10.8",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@11.18.0"
