  "license": "AGPL-3.0-or-later",
  "author": "Hanan Bhatti (https://github.com/hanan-bhatti)",
  "homepage": "https://github.com/hanan-bhatti/authn-2.0#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanan-bhatti/authn-2.0.git"
  },
  "bugs": {
