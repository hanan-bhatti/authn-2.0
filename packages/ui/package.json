{
  "name": "@authn/ui",
  "version": "0.1.0",
  "description": "Official Design System & UI Components for the Authn Platform — production-grade React components built with Tailwind CSS v4, TypeScript, and accessible primitives.",
  "license": "AGPL-3.0-or-later",
  "author": "Hanan Bhatti (https://github.com/hanan-bhatti)",
  "homepage": "https://github.com/hanan-bhatti/authn-2.0/tree/main/packages/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanan-bhatti/authn-2.0.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./fonts/*": "./src/fonts/*"
  },
  "files": [
    "dist",
    "src/styles/globals.css",
    "src/fonts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
